# 复制为 .env 后，在本机填入火山引擎 API Key；不要把真实密钥提交到代码仓库。
VOLCENGINE_REALTIME_API_KEY=

# 用于在自由对话开始前生成第一问；需要火山方舟的文本模型 API Key 与 Endpoint ID。
VOLCENGINE_TEXT_API_KEY=
VOLCENGINE_TEXT_MODEL=
# VOLCENGINE_TEXT_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 以下项都有可用默认值，通常无需修改。
VOLCENGINE_REALTIME_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
VOLCENGINE_REALTIME_MODEL=1.2.6.1
VOLCENGINE_REALTIME_VOICE=zh_female_vv_jupiter_bigtts
VOLCENGINE_REALTIME_SPEED=-10
VOLCENGINE_REALTIME_LOUDNESS=0
VOLCENGINE_END_SMOOTH_WINDOW_MS=5000
PORT=4173
